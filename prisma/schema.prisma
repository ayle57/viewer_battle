generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Session invariants (see AGENTS.md "Session invariants" for the
// full rationale) ---
//   - exactly 1 HOST per session: enforced by a hand-written partial
//     unique index in this migration's SQL (`WHERE role = 'HOST'`) —
//     not expressible via @@unique in the Prisma schema DSL.
//   - max 2 players per team (TEAM_A / TEAM_B): enforced by the
//     @@unique([sessionId, role, seat]) below. NULL is never equal to
//     NULL in a unique index, so HOST/DISPLAY rows (seat: null) never
//     collide with each other through this constraint — it only ever
//     restricts TEAM_A/TEAM_B, to at most 2 distinct seat values.
//   - unlimited DISPLAY connections tolerated, on purpose (OBS/dev) —
//     never counted as a player.
// These are real Postgres constraints, not just application checks —
// see src/server/db/participant.ts for how a race that loses at the
// constraint (P2002) gets turned into a SessionError.

enum SessionStatus {
  CREATED
  ACTIVE
  FINISHED
}

enum ParticipantRole {
  HOST
  TEAM_A
  TEAM_B
  DISPLAY
}

enum ChatChannel {
  TEAM_A
  TEAM_B
  PUBLIC
}

model Session {
  id           String        @id @default(cuid())
  code         String        @unique
  status       SessionStatus @default(CREATED)
  /// SHA-256 hash of the host's one-time recovery key (src/domain/session/
  /// hostKey.ts), generated at session.create and shown to the host
  /// exactly once. Lets reclaimHost (src/server/db/participant.ts) rotate
  /// the HOST Participant's tokenHash if the original bearer token is
  /// lost — a second, session-scoped secret for that one purpose, not a
  /// replacement for the token. Nullable only because a raw SQL migration
  /// can't backfill real hashes for sessions created before this column
  /// existed; every session created going forward always has one.
  hostKeyHash  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
  messages     ChatMessage[]
  games        SessionGame[]
}

model Participant {
  id          String          @id @default(cuid())
  sessionId   String
  session     Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        ParticipantRole
  /// Which seat (1 or 2) within the team — null for HOST/DISPLAY, which
  /// aren't seat-limited the same way. This column, not application code,
  /// is what makes "2 players per team" atomic — see @@unique below.
  seat        Int?
  displayName String
  /// SHA-256 hash of the bearer token handed to the client at join time.
  /// The plaintext token is never stored — see src/server/auth/token.ts.
  tokenHash   String          @unique
  createdAt   DateTime        @default(now())
  /// The real, persistent User account (if any) this seat belongs to —
  /// see User's own doc comment for why this is deliberately a THIRD,
  /// separate identity system from ContentHost/Participant's own bearer
  /// token, not a replacement for either. Optional: this app plays
  /// perfectly well with zero accounts at all (the "compte provisoire"
  /// join flow — a plain display name, no login) — this column only ever
  /// gets set when the joining browser was ALSO signed into a real
  /// account at that exact moment (src/server/db/participant.ts's
  /// `joinSession`), stamped once at seat-creation time, never retroactively
  /// rewritten by anything else. `onDelete: SetNull`, not Cascade —
  /// deleting a User (an admin action) must never delete the historical
  /// Session/Participant/SessionGame rows that already happened; it just
  /// stops attributing them to anyone.
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([sessionId, role, seat])
  @@index([sessionId, role])
  @@index([userId])
}

/// A real, persistent player account — username + password, deliberately
/// its own THIRD identity system, alongside Participant (one seat, one
/// live session, gone when the session's over) and ContentHost (the one
/// operator's content-prep identity). Unlike both of those, this is
/// meant to survive across every game a viewer ever plays, which is the
/// entire point: `Participant.userId` (above) links a live seat back to
/// this row so `getUserStats`/the admin dashboard (src/server/db/user.ts)
/// can compute real, cross-session stats (games played/won/tied) from
/// actually-finished SessionGame rows, not a denormalized counter that
/// could drift.
///
/// Genuinely low-stakes on purpose (see /account's own copy telling
/// people to use a throwaway password) — this app has no email, no
/// password reset flow, no PII beyond a chosen username. `passwordHash`
/// is a real one-way hash (scrypt, src/server/auth/password.ts — unlike
/// HOST_PASSWORD's plain timingSafeEqual compare, a USER-chosen password
/// is exactly the low-entropy secret a slow hash exists to protect), but
/// this is still "an account for stats and bragging rights," never
/// treated anywhere in this app as a security boundary worth more than
/// that.
model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  /// Same bearer-token scheme as Participant.tokenHash/ContentHost.tokenHash
  /// (src/server/auth/token.ts) — issued at login/register, rotated (old
  /// token stops working) on every subsequent login, same single-active-
  /// credential posture as ContentHost.signInContentHost. Null means
  /// "not currently logged in on any device" (a fresh account, or after
  /// an explicit logout — src/server/db/user.ts's `logoutUser` clears
  /// this server-side, not just the client's own localStorage).
  tokenHash    String?       @unique
  /// False for every ordinary viewer account (self-registered, no
  /// special permission) — true only for the operator's own account(s).
  /// There is no in-app screen that sets it (an operator action, not a
  /// feature a viewer can reach): the first admin is granted from the
  /// CLI (`pnpm grant-admin <username>`, scripts/grant-admin.ts). This is
  /// what actually authorizes `/host`'s own
  /// session.create/reclaimHost now (src/server/trpc/router.ts) —
  /// logging in as an `isAdmin` account is an ALTERNATIVE to typing
  /// HOST_PASSWORD directly, not a replacement for it (see that
  /// router's own doc comment): HOST_PASSWORD still works verbatim for
  /// the /dev playground and anything else that already sends it, this
  /// only ADDS a second, real-identity path for the actual product's
  /// own /host page. Never settable through any user.* procedure a
  /// plain viewer could reach — only ever flipped by hand (an admin
  /// action, same "one real operator" posture as ContentHost itself).
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  participants Participant[]
}

model ChatMessage {
  id            String          @id @default(cuid())
  sessionId     String
  session       Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  channel       ChatChannel
  role          ParticipantRole
  senderName    String
  /// A REAL, REPRODUCED bug this closes ("les equipes c'est nimp la
  /// Chat"): the client used to decide "is this MY OWN message" by
  /// comparing `role` + `senderName` alone (GameChatPanel.tsx) — two
  /// participants on the SAME team who happen to share a display name
  /// (a real, plausible scenario, not an edge case someone made up) were
  /// therefore indistinguishable, and each one's messages showed up
  /// tagged "You" on the OTHER's own screen too. A plain denormalized
  /// snapshot field, same posture as `senderName`/`role` above — NOT a
  /// real relation to `Participant` on purpose: `kickParticipant`
  /// (src/server/db/participant.ts) hard-deletes that row, and this
  /// value only ever needs to answer "was this participant me," never
  /// join back to a still-live row. Nullable because every message sent
  /// before this migration genuinely has no known value — the client
  /// treats `null` as "never mine," never as a false match.
  participantId String?
  body          String
  createdAt     DateTime        @default(now())

  @@index([sessionId, channel, createdAt])
}

/// The operator-curated chat word blocklist — applied ONLY to player
/// (TEAM_A / TEAM_B) `chat:send` messages (src/server/sockets/chat.ts via
/// src/domain/chat/wordFilter.ts); a hit blocks the whole message. One
/// row per entry so the Admin panel (/host/content/admin) can add/remove
/// individual words live with no deploy. `word` is the normalized form
/// (`normalizeBlockword` — trimmed, lower-case, accent-folded) and is
/// unique. The `BlockedWord` table is auto-seeded from
/// `DEFAULT_BLOCKED_WORDS` the first time it's found empty
/// (src/server/db/blockedWords.ts) — global, not per-session or
/// per-ContentHost: there is one real operator and one stream to protect.
model BlockedWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

// --- Game Kernel persistence (see AGENTS.md "Game Kernel contract" and
// "Vertical slice: SessionGame + realtime bridge") ---
// This table stores an opaque snapshot of whatever src/domain/game's pure
// engine produced — it contains ZERO game logic itself. The server's job
// (src/server/game) is `load internalState -> engine.apply() -> persist
// internalState`; Prisma never inspects or branches on what's inside the
// JSON, it's just bytes to this layer.
//
// `version` is optimistic concurrency for the read/apply/write cycle: an
// update is `WHERE id = ... AND version = <the version just read>`. If
// that matches zero rows, someone else's action landed first — the
// caller reloads and retries (bounded — see src/server/game/service.ts).
// No Redis, no in-memory lock: the race is broken by Postgres refusing a
// stale write, the same spirit as Participant's unique-constraint races.
//
// A session is allowed multiple SessionGame rows over its lifetime (the
// product runs several mini-games per show — see README) — sessionId is
// indexed, not unique. "The current game" is simply the most recently
// started one; nothing here supports two games running at once for the
// same session.
enum SessionGameStatus {
  IN_PROGRESS
  FINISHED
}

model SessionGame {
  id            String            @id @default(cuid())
  sessionId     String
  session       Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Which engine owns this game's rules — matches a GameEngine.id from
  /// the registry in src/domain/game/registry.ts (e.g. "board-question").
  gameKey       String
  status        SessionGameStatus @default(IN_PROGRESS)
  /// The engine's own state, exactly as src/domain/game produced it —
  /// plain JSON by the Game Kernel contract, so this column IS the entire
  /// (de)serialization story: no per-game mapping code.
  internalState Json
  version       Int               @default(0)
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  /// Which Playlist (if any) this game's initial config was snapshotted
  /// from — see "Content Studio" below. Purely provenance/metadata for the
  /// content-authoring UI (e.g. the "this playlist is currently live"
  /// banner): the Game Kernel never reads this column, and `internalState`
  /// above is already a fully independent deep copy taken at startGame
  /// time, so later edits to the Playlist can never reach a game already
  /// in progress even without this column. Null for games started before
  /// this existed, or started from the built-in sample board (no Playlist
  /// row at all). onDelete: SetNull — deleting a Playlist must not cascade
  /// into deleting the historical record of games that used it.
  playlistId    String?
  playlist      Playlist?         @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([sessionId, startedAt])
  @@index([playlistId])
}

// --- Content Studio (see AGENTS.md-equivalent reasoning below) ---
// Editorial content a Host prepares BEFORE a live show — entirely
// independent of Session/SessionGame. A Playlist can be edited freely at
// any time; starting a game takes a one-time snapshot of it into
// SessionGame.internalState (via src/domain/content's pure mapping +
// src/server/game/service.ts's startGame), so an edit made mid-game can
// never reach a game already in progress. Prisma relations model the
// obvious tree (Playlist -> PlaylistCategory -> PlaylistQuestion); the
// Game Kernel itself never reads these tables — only the content-authoring
// tRPC router (src/server/trpc/contentRouter.ts) and the one mapping step
// at game start do.

/// A persistent Host identity for Content Studio, deliberately separate
/// from Session.Participant: a Participant only exists for the lifetime
/// of one Session (cascade-deleted with it — see Session above), but
/// content must survive independently of any particular show. Same
/// bearer-token scheme as Participant.tokenHash (src/server/auth/token.ts)
/// — opaque, SHA-256 hashed, never stored in plaintext — issued once
/// after the caller proves they know HOST_PASSWORD (the same shared
/// secret that gates session.create) and then kept client-side in
/// localStorage (not sessionStorage — a content-prep workspace is meant
/// to survive across browser sessions, unlike a live game identity). Not
/// a real multi-tenant account system (no username/email/password of its
/// own) — same honest limitation as everywhere else in this app's auth
/// (see AGENTS.md "Session invariants"): losing the token means losing
/// access to that identity's playlists, same class of tradeoff as a lost
/// Participant token.
model ContentHost {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  createdAt DateTime   @default(now())
  playlists Playlist[]
}

model Playlist {
  id          String              @id @default(cuid())
  hostId      String
  host        ContentHost         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// Matches a GameEngine.id (src/domain/game/registry.ts) — future-proofs
  /// the content model for a second game's own playlists without a schema
  /// change. Exercised by six now: "board-question" (Mini Jeopardy,
  /// categories/questions below), "geoguessr" (rounds below), "drawing"
  /// (prompts below), "music" (tracks below), "steamRatings" (steam
  /// games below), and "guessThePrice" (price items below) — the SAME
  /// Playlist entity/ownership/CRUD surface serves every game's
  /// top-level "named thing a Host prepares," with a game-specific
  /// CHILD table for each game's own content shape (a Jeopardy playlist
  /// only ever has `categories` populated; a GeoGuessr playlist only
  /// ever has `rounds` populated; etc — nothing enforces that at the
  /// schema level, it falls out of which tRPC procedures a given
  /// `gameKey` ever calls, see contentRouter.ts / contentGeoRouter.ts /
  /// contentDrawingRouter.ts / contentMusicRouter.ts /
  /// contentSteamRouter.ts / contentPriceRouter.ts).
  gameKey     String
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  categories  PlaylistCategory[]
  rounds      PlaylistRound[]
  prompts     PlaylistPrompt[]
  tracks      PlaylistTrack[]
  steamGames  PlaylistSteamGame[]
  priceItems  PlaylistPriceItem[]
  games       SessionGame[]

  @@index([hostId, gameKey])
}

model PlaylistCategory {
  id         String             @id @default(cuid())
  playlistId String
  playlist   Playlist           @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  name       String
  /// Reorder position within the playlist — an integer, not a linked list;
  /// reordering rewrites every affected row's position in one transaction
  /// (src/server/db/content.ts), same spirit as PlaylistQuestion.position.
  position   Int
  questions  PlaylistQuestion[]

  @@index([playlistId, position])
}

model PlaylistQuestion {
  id         String           @id @default(cuid())
  categoryId String
  category   PlaylistCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Denormalized from category.playlistId — lets ownership/listing
  /// queries (src/server/db/content.ts) filter straight on
  /// PlaylistQuestion without an extra join through PlaylistCategory for
  /// every check.
  playlistId String
  /// The board cell's point value — a plain editable int, not a hardcoded
  /// 100/200/300/400 enum, so a Host can build boards with different
  /// values if the engine allows it later. BoardQuestionEngine only
  /// requires a positive int (see boardQuestionSchema) — this column
  /// matches that, nothing narrower.
  value      Int
  prompt     String
  answer     String
  position   Int

  @@index([categoryId, position])
  @@index([playlistId])
}

/// GeoGuessr's own content shape — flat rounds, not a category tree (see
/// Playlist's own comment on why the two games share one Playlist entity
/// with different children). Nullable `imageUrl`/`targetX`/`targetY` on
/// purpose: a Host can create a round shell (get an id, a position on the
/// list) BEFORE picking an image or clicking a target, same as a
/// PlaylistCategory can exist with zero questions — "exists but
/// incomplete" is a real, distinct state from "doesn't exist," and
/// src/domain/content/geoReadiness.ts is what turns "incomplete" into a
/// real reason a Host can't start the show (see that file).
///
/// `imageUrl` is an opaque string, not a foreign key into an asset table
/// — deliberately: this app has no upload/asset-storage system yet (see
/// the product brief this shipped against), so a round's image today is
/// literally its serving path under `public/` (e.g.
/// "/images/maps/sample-world-map.png", discovered dynamically —
/// src/server/content/geoAssets.ts — never hardcoded into the Game
/// Kernel). Swapping this for real object storage later is a change to
/// what populates this ONE string column and to geoAssets.ts, nothing
/// about GeoGuessrEngine or this schema's shape.
///
/// `targetX`/`targetY` are normalized 0..1 floats (see
/// src/domain/game/geoGuessr/types.ts's top comment) — independent of
/// the image's rendered size in any client (desktop/tablet/mobile/OBS
/// 16:9), which is the entire reason they're stored this way instead of
/// absolute pixels.
model PlaylistRound {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /// Reorder position within the playlist — same integer-position scheme
  /// as PlaylistCategory.position/PlaylistQuestion.position above, not a
  /// linked list; reordering rewrites every affected row's position in
  /// one transaction (src/server/db/contentGeo.ts).
  position   Int
  title      String?
  /// The player-facing prompt — "Where is the docking bay?" — shown to
  /// every non-host role for the WHOLE guessing phase (unlike
  /// targetX/targetY, never redacted while the round is current: a
  /// player can't play a round they don't know the question for). Kept
  /// separate from `title` on purpose: `title` is an editorial label for
  /// the Content Studio round list/Host-Display headers ("Dam
  /// Battlegrounds"), `question` is literally what's asked of the
  /// player — the same split Jeopardy has between a category's name and
  /// a question's own prompt.
  question   String?
  imageUrl   String?
  targetX    Float?
  targetY    Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([playlistId, position])
}

/// Drawing's own content shape — a flat, ordered list of drawing prompts
/// ("chenille", "dragon", ...), the Drawing counterpart to PlaylistRound
/// above: same flat-list-not-category-tree reasoning (see that model's
/// own comment) but simpler still — a prompt is just text plus a
/// per-prompt timer, no image/target asset fields at all.
///
/// `text` nullable on purpose, same "shell now, fill in later" pattern
/// as PlaylistRound.question — a Host can create a prompt row (get an
/// id, a position on the list) before typing its word;
/// src/domain/content/drawingReadiness.ts is what turns "incomplete"
/// into a real reason a Host can't start the show.
///
/// `durationSeconds` is the one field genuinely new to this app's
/// Content Studio shape (no existing PlaylistQuestion/PlaylistRound
/// field is a duration) — this is the literal "set the timer per round"
/// product requirement: src/server/game/service.ts's startGame
/// snapshots this straight into DrawingEngine's own per-turn
/// countdown deadline (src/domain/game/drawing/engine.ts's
/// applyChooseDrawer), so a later edit here can never change a round
/// already in progress. Defaults to 30s; a Host raises it (60/90...) for
/// harder prompts. A plain editable positive int, no DB-level CHECK —
/// same posture as PlaylistQuestion.value.
model PlaylistPrompt {
  id              String   @id @default(cuid())
  playlistId      String
  playlist        Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /// Reorder position within the playlist — same integer-position scheme
  /// as every other Playlist child's own `position` field, not a linked
  /// list; reordering rewrites every affected row's position in one
  /// transaction (src/server/db/contentDrawing.ts).
  position        Int
  text            String?
  durationSeconds Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([playlistId, position])
}

/// "Guess the Music"'s own content shape — a flat, ordered list of audio
/// tracks, the Music counterpart to PlaylistRound/PlaylistPrompt above:
/// same flat-list-not-category-tree reasoning (see PlaylistRound's own
/// comment) — a track is an uploaded audio clip plus its reference
/// answer (`title`/optional `artist`), no per-round scoring value at all
/// (src/domain/game/music/types.ts's top comment: every correctly-
/// judged round is worth exactly 1 point, "un scoring system simple" —
/// unlike PlaylistQuestion.value, there's nothing here to configure per
/// track).
///
/// `audioUrl`/`title` nullable on purpose, same "shell now, fill in
/// later" pattern as PlaylistRound.imageUrl/PlaylistPrompt.text — a Host
/// can create a track row (get an id, a position on the list) before
/// uploading a clip or naming it; src/domain/content/musicReadiness.ts
/// is what turns "incomplete" into a real reason a Host can't start the
/// show. `artist` is always optional, even once "complete" — some clips
/// (instrumentals, game/movie themes, memes) have no meaningful separate
/// artist to name (src/domain/game/music/types.ts's musicRoundSchema).
///
/// `audioUrl` is an opaque string, not a foreign key into an asset table
/// — same posture as PlaylistRound.imageUrl: this app has no
/// upload/asset-storage system beyond a local `public/` directory per
/// content type (see src/server/content/musicAssets.ts, the Music
/// counterpart to geoAssets.ts).
model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /// Reorder position within the playlist — same integer-position scheme
  /// as every other Playlist child's own `position` field, not a linked
  /// list; reordering rewrites every affected row's position in one
  /// transaction (src/server/db/contentMusic.ts).
  position   Int
  audioUrl   String?
  title      String?
  artist     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([playlistId, position])
}

/// "Guess the Game" (Steam Ratings)'s own content shape — a flat, ordered
/// list of game entries, the Steam-Ratings counterpart to PlaylistTrack
/// above: same flat-list-not-category-tree reasoning (see PlaylistRound's
/// own comment) — one entry is one Steam game the Host prepared: its own
/// name (`title`, the reference answer), a cover image, and an ORDERED
/// list of that game's own Steam user reviews, least obvious first
/// (src/domain/game/steamRatings/types.ts's top comment: the reveal order
/// IS this array's order). No per-round scoring value, same "un scoring
/// system simple" posture as PlaylistTrack — every correctly-judged round
/// is worth exactly 1 point.
///
/// `ratings` is a native Postgres `String[]`, not its own child table —
/// deliberately NOT PlaylistCategory/PlaylistQuestion's two-level shape:
/// a rating has no identity of its own worth an id (no reorder-by-drag,
/// no delete-just-one-and-keep-the-rest-stable elsewhere), it only ever
/// gets edited as a whole ordered batch inside one game entry's own
/// editor (src/app/host/content/steamRatings/playlists/[id]/
/// GameEditorPanel.tsx) and read back the same way
/// (playlistToSteamRatingsConfig). A plain scalar list column is the
/// honest shape for that, not an over-normalized child table.
///
/// `title`/`imageUrl` nullable on purpose, same "shell now, fill in
/// later" pattern as PlaylistTrack.audioUrl/title — a Host can create a
/// game row (get an id, a position on the list) before naming it or
/// uploading its cover; src/domain/content/steamReadiness.ts is what
/// turns "incomplete" into a real reason a Host can't start the show.
/// `ratings` defaults to an empty array for the exact same "shell, not
/// yet complete" reason — readiness requires at least one.
///
/// `imageUrl` is an opaque string, not a foreign key into an asset table
/// — same posture as PlaylistTrack.audioUrl: this app has no
/// upload/asset-storage system beyond a local `public/` directory per
/// content type (see src/server/content/steamAssets.ts, the Steam
/// Ratings counterpart to geoAssets.ts/musicAssets.ts).
model PlaylistSteamGame {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /// Reorder position within the playlist — same integer-position scheme
  /// as every other Playlist child's own `position` field, not a linked
  /// list; reordering rewrites every affected row's position in one
  /// transaction (src/server/db/contentSteam.ts).
  position   Int
  title      String?
  imageUrl   String?
  ratings    String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([playlistId, position])
}

/// "Guess the Price" content — a flat, ordered list of priced items, same
/// shape as PlaylistSteamGame above (one child row per round, no nested
/// category/round-of-rounds structure). `price`/`marginPercent` are the
/// two fields with no counterpart on any other game's child table: the
/// REFERENCE price the Host judges a team's oral guess against (hidden
/// from every other role until a round is revealed — same posture as
/// PlaylistSteamGame.title/imageUrl, see src/domain/game/guessThePrice/
/// types.ts's top comment), and an OPTIONAL tolerance the Host can set
/// per item if they want a "close enough" guideline instead of judging
/// purely by ear — "il faut qu'il puisse mettre la marge de prix seul
/// si il veut en mettre une." Both stay null on an incomplete/freshly
/// created item, same "exists but incomplete" shape as PlaylistTrack.
model PlaylistPriceItem {
  id            String   @id @default(cuid())
  playlistId    String
  playlist      Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /// Reorder position within the playlist — same integer-position scheme
  /// as every other Playlist child's own `position` field, not a linked
  /// list; reordering rewrites every affected row's position in one
  /// transaction (src/server/db/contentPrice.ts).
  position      Int
  title         String?
  imageUrl      String?
  price         Float?
  marginPercent Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

