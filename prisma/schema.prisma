generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Session invariants (see AGENTS.md "Session invariants" for the
// full rationale) ---
//   - exactly 1 HOST per session: enforced by a hand-written partial
//     unique index in this migration's SQL (`WHERE role = 'HOST'`) —
//     not expressible via @@unique in the Prisma schema DSL.
//   - max 2 players per team (TEAM_A / TEAM_B): enforced by the
//     @@unique([sessionId, role, seat]) below. NULL is never equal to
//     NULL in a unique index, so HOST/DISPLAY rows (seat: null) never
//     collide with each other through this constraint — it only ever
//     restricts TEAM_A/TEAM_B, to at most 2 distinct seat values.
//   - unlimited DISPLAY connections tolerated, on purpose (OBS/dev) —
//     never counted as a player.
// These are real Postgres constraints, not just application checks —
// see src/server/db/participant.ts for how a race that loses at the
// constraint (P2002) gets turned into a SessionError.

enum SessionStatus {
  CREATED
  ACTIVE
  FINISHED
}

enum ParticipantRole {
  HOST
  TEAM_A
  TEAM_B
  DISPLAY
}

enum ChatChannel {
  TEAM_A
  TEAM_B
  PUBLIC
}

model Session {
  id           String        @id @default(cuid())
  code         String        @unique
  status       SessionStatus @default(CREATED)
  /// SHA-256 hash of the host's one-time recovery key (src/domain/session/
  /// hostKey.ts), generated at session.create and shown to the host
  /// exactly once. Lets reclaimHost (src/server/db/participant.ts) rotate
  /// the HOST Participant's tokenHash if the original bearer token is
  /// lost — a second, session-scoped secret for that one purpose, not a
  /// replacement for the token. Nullable only because a raw SQL migration
  /// can't backfill real hashes for sessions created before this column
  /// existed; every session created going forward always has one.
  hostKeyHash  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
  messages     ChatMessage[]
  games        SessionGame[]
}

model Participant {
  id          String          @id @default(cuid())
  sessionId   String
  session     Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        ParticipantRole
  /// Which seat (1 or 2) within the team — null for HOST/DISPLAY, which
  /// aren't seat-limited the same way. This column, not application code,
  /// is what makes "2 players per team" atomic — see @@unique below.
  seat        Int?
  displayName String
  /// SHA-256 hash of the bearer token handed to the client at join time.
  /// The plaintext token is never stored — see src/server/auth/token.ts.
  tokenHash   String          @unique
  createdAt   DateTime        @default(now())

  @@unique([sessionId, role, seat])
  @@index([sessionId, role])
}

model ChatMessage {
  id         String          @id @default(cuid())
  sessionId  String
  session    Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  channel    ChatChannel
  role       ParticipantRole
  senderName String
  body       String
  createdAt  DateTime        @default(now())

  @@index([sessionId, channel, createdAt])
}

// --- Game Kernel persistence (see AGENTS.md "Game Kernel contract" and
// "Vertical slice: SessionGame + realtime bridge") ---
// This table stores an opaque snapshot of whatever src/domain/game's pure
// engine produced — it contains ZERO game logic itself. The server's job
// (src/server/game) is `load internalState -> engine.apply() -> persist
// internalState`; Prisma never inspects or branches on what's inside the
// JSON, it's just bytes to this layer.
//
// `version` is optimistic concurrency for the read/apply/write cycle: an
// update is `WHERE id = ... AND version = <the version just read>`. If
// that matches zero rows, someone else's action landed first — the
// caller reloads and retries (bounded — see src/server/game/service.ts).
// No Redis, no in-memory lock: the race is broken by Postgres refusing a
// stale write, the same spirit as Participant's unique-constraint races.
//
// A session is allowed multiple SessionGame rows over its lifetime (the
// product runs several mini-games per show — see README) — sessionId is
// indexed, not unique. "The current game" is simply the most recently
// started one; nothing here supports two games running at once for the
// same session.
enum SessionGameStatus {
  IN_PROGRESS
  FINISHED
}

model SessionGame {
  id            String            @id @default(cuid())
  sessionId     String
  session       Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Which engine owns this game's rules — matches a GameEngine.id from
  /// the registry in src/domain/game/registry.ts (e.g. "board-question").
  gameKey       String
  status        SessionGameStatus @default(IN_PROGRESS)
  /// The engine's own state, exactly as src/domain/game produced it —
  /// plain JSON by the Game Kernel contract, so this column IS the entire
  /// (de)serialization story: no per-game mapping code.
  internalState Json
  version       Int               @default(0)
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  /// Which Playlist (if any) this game's initial config was snapshotted
  /// from — see "Content Studio" below. Purely provenance/metadata for the
  /// content-authoring UI (e.g. the "this playlist is currently live"
  /// banner): the Game Kernel never reads this column, and `internalState`
  /// above is already a fully independent deep copy taken at startGame
  /// time, so later edits to the Playlist can never reach a game already
  /// in progress even without this column. Null for games started before
  /// this existed, or started from the built-in sample board (no Playlist
  /// row at all). onDelete: SetNull — deleting a Playlist must not cascade
  /// into deleting the historical record of games that used it.
  playlistId    String?
  playlist      Playlist?         @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([sessionId, startedAt])
  @@index([playlistId])
}

// --- Content Studio (see AGENTS.md-equivalent reasoning below) ---
// Editorial content a Host prepares BEFORE a live show — entirely
// independent of Session/SessionGame. A Playlist can be edited freely at
// any time; starting a game takes a one-time snapshot of it into
// SessionGame.internalState (via src/domain/content's pure mapping +
// src/server/game/service.ts's startGame), so an edit made mid-game can
// never reach a game already in progress. Prisma relations model the
// obvious tree (Playlist -> PlaylistCategory -> PlaylistQuestion); the
// Game Kernel itself never reads these tables — only the content-authoring
// tRPC router (src/server/trpc/contentRouter.ts) and the one mapping step
// at game start do.

/// A persistent Host identity for Content Studio, deliberately separate
/// from Session.Participant: a Participant only exists for the lifetime
/// of one Session (cascade-deleted with it — see Session above), but
/// content must survive independently of any particular show. Same
/// bearer-token scheme as Participant.tokenHash (src/server/auth/token.ts)
/// — opaque, SHA-256 hashed, never stored in plaintext — issued once
/// after the caller proves they know HOST_PASSWORD (the same shared
/// secret that gates session.create) and then kept client-side in
/// localStorage (not sessionStorage — a content-prep workspace is meant
/// to survive across browser sessions, unlike a live game identity). Not
/// a real multi-tenant account system (no username/email/password of its
/// own) — same honest limitation as everywhere else in this app's auth
/// (see AGENTS.md "Session invariants"): losing the token means losing
/// access to that identity's playlists, same class of tradeoff as a lost
/// Participant token.
model ContentHost {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  createdAt DateTime   @default(now())
  playlists Playlist[]
}

model Playlist {
  id          String             @id @default(cuid())
  hostId      String
  host        ContentHost        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// Matches a GameEngine.id (src/domain/game/registry.ts) — future-proofs
  /// the content model for a second game's own playlists without a schema
  /// change. Now genuinely exercised by two: "board-question" (Mini
  /// Jeopardy, categories/questions below) and "geoguessr" (rounds below)
  /// — the SAME Playlist entity/ownership/CRUD surface serves both games'
  /// top-level "named thing a Host prepares," with a game-specific CHILD
  /// table for each game's own content shape (a Jeopardy playlist only
  /// ever has `categories` populated; a GeoGuessr playlist only ever has
  /// `rounds` populated — nothing enforces that at the schema level, it
  /// falls out of which tRPC procedures a given `gameKey` ever calls, see
  /// contentRouter.ts / contentGeoRouter.ts).
  gameKey     String
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  categories  PlaylistCategory[]
  rounds      PlaylistRound[]
  games       SessionGame[]

  @@index([hostId, gameKey])
}

model PlaylistCategory {
  id         String             @id @default(cuid())
  playlistId String
  playlist   Playlist           @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  name       String
  /// Reorder position within the playlist — an integer, not a linked list;
  /// reordering rewrites every affected row's position in one transaction
  /// (src/server/db/content.ts), same spirit as PlaylistQuestion.position.
  position   Int
  questions  PlaylistQuestion[]

  @@index([playlistId, position])
}

model PlaylistQuestion {
  id         String           @id @default(cuid())
  categoryId String
  category   PlaylistCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Denormalized from category.playlistId — lets ownership/listing
  /// queries (src/server/db/content.ts) filter straight on
  /// PlaylistQuestion without an extra join through PlaylistCategory for
  /// every check.
  playlistId String
  /// The board cell's point value — a plain editable int, not a hardcoded
  /// 100/200/300/400 enum, so a Host can build boards with different
  /// values if the engine allows it later. BoardQuestionEngine only
  /// requires a positive int (see boardQuestionSchema) — this column
  /// matches that, nothing narrower.
  value      Int
  prompt     String
  answer     String
  position   Int

  @@index([categoryId, position])
  @@index([playlistId])
}

/// GeoGuessr's own content shape — flat rounds, not a category tree (see
/// Playlist's own comment on why the two games share one Playlist entity
/// with different children). Nullable `imageUrl`/`targetX`/`targetY` on
/// purpose: a Host can create a round shell (get an id, a position on the
/// list) BEFORE picking an image or clicking a target, same as a
/// PlaylistCategory can exist with zero questions — "exists but
/// incomplete" is a real, distinct state from "doesn't exist," and
/// src/domain/content/geoReadiness.ts is what turns "incomplete" into a
/// real reason a Host can't start the show (see that file).
///
/// `imageUrl` is an opaque string, not a foreign key into an asset table
/// — deliberately: this app has no upload/asset-storage system yet (see
/// the product brief this shipped against), so a round's image today is
/// literally its serving path under `public/` (e.g.
/// "/images/maps/ac_odyssey_world_map.jpg", discovered dynamically —
/// src/server/content/geoAssets.ts — never hardcoded into the Game
/// Kernel). Swapping this for real object storage later is a change to
/// what populates this ONE string column and to geoAssets.ts, nothing
/// about GeoGuessrEngine or this schema's shape.
///
/// `targetX`/`targetY` are normalized 0..1 floats (see
/// src/domain/game/geoGuessr/types.ts's top comment) — independent of
/// the image's rendered size in any client (desktop/tablet/mobile/OBS
/// 16:9), which is the entire reason they're stored this way instead of
/// absolute pixels.
model PlaylistRound {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /// Reorder position within the playlist — same integer-position scheme
  /// as PlaylistCategory.position/PlaylistQuestion.position above, not a
  /// linked list; reordering rewrites every affected row's position in
  /// one transaction (src/server/db/contentGeo.ts).
  position   Int
  title      String?
  /// The player-facing prompt — "Where is the docking bay?" — shown to
  /// every non-host role for the WHOLE guessing phase (unlike
  /// targetX/targetY, never redacted while the round is current: a
  /// player can't play a round they don't know the question for). Kept
  /// separate from `title` on purpose: `title` is an editorial label for
  /// the Content Studio round list/Host-Display headers ("Dam
  /// Battlegrounds"), `question` is literally what's asked of the
  /// player — the same split Jeopardy has between a category's name and
  /// a question's own prompt.
  question   String?
  imageUrl   String?
  targetX    Float?
  targetY    Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([playlistId, position])
}
