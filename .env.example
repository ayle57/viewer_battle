# Copy to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string used by Prisma when running natively
# (pnpm dev / pnpm start against a local Postgres, not Docker Compose).
DATABASE_URL="postgresql://user:password@localhost:5432/viewerbattle"

# Port the Next.js + Socket.IO custom server listens on.
PORT=3000

# --- docker-compose.yml only ---
# Used to build the app container's DATABASE_URL against the `postgres`
# service (see docker-compose.yml) and to initialize the Postgres container.
# Not used by `pnpm dev` / `pnpm start` — those read DATABASE_URL above.
POSTGRES_PASSWORD="change-me"
