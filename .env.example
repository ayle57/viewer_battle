# Copy to .env and fill in real values. .env is gitignored.
# See SETUP.md for the full first-run walkthrough.

# --- required by `pnpm dev` / `pnpm start` / `pnpm grant-admin` ---

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/viewerbattle"

# Port the Next.js + Socket.IO custom server listens on.
PORT=3000

# Shared secret for the Content Studio / Admin panel sign-in (the
# "Host password" field at /host/content) and for the /dev playground.
# The product's own /host game-hosting page uses a real admin ACCOUNT
# instead (see SETUP.md — `pnpm grant-admin`), not this password.
# Use a long random string. See src/server/auth/hostPassword.ts.
HOST_PASSWORD="change-me-to-a-long-random-string"

# Optional: pino log level (trace|debug|info|warn|error). Defaults to info.
# LOG_LEVEL="info"

# --- docker-compose.yml only (ignored by `pnpm dev` / `pnpm start`) ---

# Postgres superuser password for the `postgres` service; also used to
# build the app container's DATABASE_URL against that service.
POSTGRES_PASSWORD="change-me"
